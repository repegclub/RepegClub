ADMIN_MNEMONIC=
PLAYER1_MNEMONIC=
PLAYER2_MNEMONIC=

# Wallet passed to instantiate as `commit_pusher` - see wheel-manager's
# `Config::commit_pusher` doc comment. Deliberately separate from ADMIN_MNEMONIC
# and from KEEPER_MNEMONIC (see keeper.ts) - only used by
# generateAndPushCommits.ts, never by the always-on keeper process.
COMMIT_PUSHER_MNEMONIC=

# Used by keeper.ts if set; falls back to ADMIN_MNEMONIC otherwise (local
# testing convenience only - production keeper deployments should always set
# this to a dedicated wallet, never the admin one, see the project's Obsidian
# notes on "Grinding vía SubMsg+reply").
KEEPER_MNEMONIC=

# MAINNET_TEST_ADMIN_MNEMONIC / MAINNET_TEST_PLAYER2_MNEMONIC (real mainnet
# funds - see scripts/testnet/src/configMainnetTest.ts) are deliberately NOT
# listed here. Export them as real shell environment variables instead of
# writing real mnemonics to any file, even this gitignored one.
